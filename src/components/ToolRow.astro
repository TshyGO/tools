---
import type { Tool } from '../data/tools';
import SupportButton from './SupportButton.astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const shot = tool.screenshots[0];
---

<article class="tool-row">
  <a class="tool-row__shot" href={tool.detailPath} aria-hidden="true" tabindex="-1">
    <picture>
      <source media="(max-width: 720px)" srcset={shot.thumbWide} width="720" height="405" />
      <img src={shot.thumb} alt="" width="600" height="480" />
    </picture>
  </a>
  <div class="tool-row__body">
    <span class="pill"><i></i>{tool.platform} · {tool.status}</span>
    <h2 class="tool-row__name">
      <img class="tool-icon" src={tool.icon} alt="" width="28" height="28" />
      <a href={tool.detailPath}>{tool.name}</a>
    </h2>
    <p class="tool-row__desc">{tool.tagline}</p>
    <p class="tool-row__meta">下载页自动查询最新正式版</p>
    <div class="tool-row__actions">
      <a class="button button--primary button--sm" href={tool.links.primary.href} target="_blank" rel="noreferrer">{tool.links.primary.label}</a>
      <a class="button button--sm" href={tool.detailPath}>使用说明</a>
      <a class="button button--sm" href={tool.faqPath}>常见问题</a>
      <SupportButton small />
    </div>
  </div>
</article>
