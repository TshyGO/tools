---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<article class="tool-entry reveal" data-tool={tool.slug}>
  <a class="tool-entry__main" href={tool.detailPath} aria-label={`查看${tool.name}详情`}>
    <span class="tool-entry__index" aria-hidden="true">{tool.index}</span>
    <span class="tool-entry__icon" aria-hidden="true">
      <svg viewBox="0 0 48 48" role="img">
        <path d="M14 9.5h15l7 7V38.5H14z" />
        <path d="M29 9.5v8h7M19 25h12M19 31h9" />
      </svg>
    </span>
    <span class="tool-entry__identity">
      <span class="tool-entry__eyebrow">{tool.englishName}</span>
      <strong>{tool.name}</strong>
    </span>
    <span class="tool-entry__description">{tool.description}</span>
    <span class="tool-entry__meta">
      <span>{tool.category}</span>
      <span>{tool.openSource ? '开源' : '免费使用'}</span>
      <span class="tool-entry__status"><i></i>{tool.status}</span>
    </span>
    <span class="tool-entry__arrow" aria-hidden="true">↗</span>
  </a>
  <a class="tool-entry__download" href={tool.releaseUrl} target="_blank" rel="noreferrer">
    下载最新版
    <span aria-hidden="true">↓</span>
  </a>
</article>
