---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolRow from '../components/ToolRow.astro';
import { tools } from '../data/tools';
---

<BaseLayout
  title="PeterKit｜免费、开源的小工具"
  description="免费、开源的小工具目录。当前：简历灵填助手，读取 Excel 简历，一键填写网申表单。"
>
  <header class="site-header">
    <a class="brand" href="/">
      <span class="brand__mark">PK</span>
      <span>PeterKit</span>
    </a>
    <nav>
      <a href="https://github.com/TshyGO/tools" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://github.com/TshyGO/tools/issues" target="_blank" rel="noreferrer">反馈</a>
    </nav>
  </header>

  <main>
    <div class="intro">
      <h1>工具目录</h1>
      <p>免费、开源。每个工具都有独立的下载和使用说明。</p>
    </div>

    <div class="directory">
      {tools.map((tool) => <ToolRow tool={tool} />)}
    </div>
  </main>

  <footer class="site-footer">
    <span>MIT · 开源</span>
    <nav>
      <a href="https://github.com/TshyGO/tools" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://github.com/TshyGO/tools/issues" target="_blank" rel="noreferrer">问题反馈</a>
    </nav>
  </footer>
</BaseLayout>
